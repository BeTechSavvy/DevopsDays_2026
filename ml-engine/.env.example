# Copy to ml-engine/.env and fill in. .env is gitignored -- never commit it.

# Required for RCA (Gemini). Without it the pipeline still runs, just with --no-rca behaviour.
GOOGLE_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash

# Defaults shown; only set these if yours differ.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=chaos_healer
API_PORT=5050
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
FLASK_URL=http://127.0.0.1:30001
